# Copy to .env and fill in what you have. Never commit .env.

PORT=3000

# --- Database -------------------------------------------------------------
# Supabase Postgres connection string: Supabase dashboard -> Connect -> "Transaction pooler" -> URI,
# with [YOUR-PASSWORD] replaced by the database password. Leave empty to use the embedded
# local database in data/pglite (fine for trying things out on your computer).
DATABASE_URL=

# --- Access ---------------------------------------------------------------
# Password for the owner dashboard and the buyer simulator. Required on Vercel.
APP_PASSWORD=
# Allow the "Reset demo" button on a deployed site (wipes all data). Off by default there.
ALLOW_DEMO_RESET=false

# --- AI -------------------------------------------------------------------
# Claude API. Without a key the app uses its built-in rule-based assistant.
ANTHROPIC_API_KEY=
# "off" forces the rule-based assistant; "claude" forces Claude (e.g. after `ant auth login`).
AI_MODE=

# --- Behaviour ------------------------------------------------------------
# Reservation lifetimes, in minutes.
DRAFT_HOLD_MINUTES=120
QUOTED_HOLD_MINUTES=1440

# --- WhatsApp Business Cloud API (optional) --------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
