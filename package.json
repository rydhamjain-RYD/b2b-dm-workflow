{
  "name": "b2b-dm-workflow",
  "version": "0.1.0",
  "private": true,
  "description": "AI sales assistant for B2B DMs: requirement capture, inventory ledger with atomic reservations, owner approval gates, rules-based billing.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "test": "node --test --test-concurrency=1 \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "reset": "node --env-file-if-exists=.env src/scripts/reset.ts",
    "db:migrate": "node --env-file-if-exists=.env src/scripts/migrate.ts",
    "build:vercel": "node --env-file-if-exists=.env scripts/build-vercel.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@electric-sql/pglite": "^0.6.0",
    "express": "^5.3.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  }
}
